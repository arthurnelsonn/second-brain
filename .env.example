# Personal Command Center — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Path to the SQLite database file (optional — defaults to ~/.pcc/data/pcc.db)
PCC_DB_PATH=~/.pcc/data/pcc.db

# Path to the encrypted secrets directory (optional — defaults to ~/.pcc/secrets)
PCC_SECRETS_PATH=~/.pcc/secrets

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Next.js secret for signing cookies/tokens — generate with:
# openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
